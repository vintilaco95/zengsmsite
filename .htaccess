# ZEN GSM — URL-uri SEO pentru articole blog (Apache + mod_rewrite)
# Render (site static): vezi render.yaml → routes (rewrite), nu .htaccess.
# Altfel, vezi comentariul Nginx de la final.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 301: formular vechi ?slug= → URL canonic /blog/slug (agregă semnale SEO pe un singur URL)
RewriteCond %{THE_REQUEST} \s/+blog-articol\.html\?slug=([^\s&]+)\S*\s [NC]
RewriteRule ^blog-articol\.html$ /blog/%1? [R=301,L]

# Intern: /blog/slug → același HTML shell; slug din query pentru script (blogger din data-* în pagină)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([^/]+)/?$ blog-articol.html?slug=$1 [L,QSA]
</IfModule>

# ---
# Nginx (echivalent aproximativ):
